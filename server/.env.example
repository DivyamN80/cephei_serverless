MONGODB_URI=
JWT_SECRET=
# Any random string — used to derive the AES-256 key that encrypts project
# secrets (per-project env vars) at rest. Changing this after secrets exist
# makes them permanently undecryptable, same caveat as JWT_SECRET.
SECRETS_ENCRYPTION_KEY=
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional. Only raises this server's own unauthenticated GitHub API rate
# limit for public-repo lookups (repoIngest.js's default fetchRepoMetadata/
# probeIsPrivate calls when no per-project credential is supplied). This is
# unrelated to any specific customer's PAT or SSH deploy key — those are
# per-project, submitted via POST /api/projects/:id/github-auth, and stored
# AES-256-GCM encrypted in the database (Project.githubAuth), never here.
GITHUB_TOKEN=
# Required to onboard AWS customers. This is CEPHEI'S OWN AWS account ID
# (the vendor side), not any customer's — it's the account the generated
# CloudFormation template's CepheiDeployRole trust policy grants
# sts:AssumeRole to (Principal: arn:aws:iam::<this>:root, plus the
# per-customer ExternalId condition). See
# providers/aws/cfnTemplate.js#buildDeployRoleTemplate. Without it, POST
# /api/customer-aws-accounts with provider: 'aws' fails. Not currently read
# anywhere else in this codebase — in particular, providers/aws/deploy.js's
# resolveAccountId() does NOT use it; a customer's own AWS account ID comes
# from their stored CustomerAwsAccount.awsAccountId (or an STS
# GetCallerIdentity call as a fallback).
AWS_ACCOUNT_ID=
